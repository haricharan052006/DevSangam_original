# Backend REST API origin (no trailing slash, no path).
VITE_API_BASE_URL=http://localhost:5000

# Backend websocket origin (no trailing slash, no path) — /yjs and /exec are
# appended in code (see src/config/api.js) for the collab-doc sync socket
# and the shared execution/governance/voice socket respectively.
VITE_WS_URL=ws://localhost:5000
