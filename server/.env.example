PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Supabase (or any) Postgres connection string. Settings > Database >
# Connection string > Transaction pooler in the Supabase dashboard.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# auto | docker | local | mock
# auto: use Docker if the daemon is reachable, else fall back to a local
# interpreter/compiler for that language, else fall back to a mock response.
# On most hosted platforms (Render, Railway, etc.) without Docker-in-Docker,
# set this to "mock" unless you've provisioned a sandboxed execution worker.
EXECUTION_MODE=auto

# Comma-separated list of allowed frontend origins in production, e.g.
# https://devsangam.vercel.app,https://devsangam.example.com
# Leave unset in local dev — CORS then falls back to CLIENT_URL below.
CORS_ORIGIN=

# AI Assistant (Review / Optimize / Explain in the editor). Get a key at
# https://aistudio.google.com/apikey. Leave blank to disable the feature —
# POST /api/ai/analyze responds 503 instead of crashing at startup.
GEMINI_API_KEY=
# Optional — defaults to gemini-3.6-flash if unset.
GEMINI_MODEL=

# Google OAuth (Sign in with Google + "Recover with Google" password reset).
# Create credentials at https://console.cloud.google.com/apis/credentials —
# an OAuth 2.0 Client ID of type "Web application", with GOOGLE_CALLBACK_URL
# added under "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Where the browser is sent after a Google OAuth round-trip completes.
CLIENT_URL=http://localhost:5173
